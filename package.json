{
  "name": "openhfx",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "map-worker": "node scripts/copy-map-worker.mjs",
    "predev": "npm run map-worker",
    "prebuild": "npm run map-worker",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-workflow.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "lucide-react": "1.45.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
