{
  "name": "openhfx",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "map-worker": "node scripts/copy-map-worker.mjs",
    "prepare-assets": "npm run tokens && npm run map-worker",
    "predev": "npm run prepare-assets",
    "dev": "next dev",
    "prebuild": "npm run prepare-assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3"
  }
}
