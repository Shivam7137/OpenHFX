# Optional Anthropic connection. Keep the actual key only in ignored .env.local.
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# Use provider with LLM_PROVIDER=anthropic and LLM_MODEL=claude-sonnet-4-6.
# Default demo requires no key and makes no paid calls.
OPENHFX_ENGINE_MODE=demo
OPENHFX_DEMO_MODE=true
OPENHFX_DATA_DIR=.data

# Demo sign-in is local only. Real identity/hosting must be configured before public use.

# Public basemap configuration. Never put private credentials in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Optional attribution HTML for a custom provider; the default credits OpenFreeMap/OSM.
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Optional server-to-server Dispatcher connection. Never use NEXT_PUBLIC_ for these.
# Run Dispatcher on port 3002, OpenHFX on port 3000. See docs/DEMO_CALLS.md.
OPENHFX_DISPATCHER_URL=http://127.0.0.1:3002
OPENHFX_DISPATCHER_TOKEN=
