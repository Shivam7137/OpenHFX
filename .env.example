# Basemap style for the public map. MapLibre GL JS renders the map but supplies
# no tiles; point this at an open style you are entitled to use, or at your own
# self-hosted tiles before treating the map as a production service.
# Default: OpenFreeMap (OpenStreetMap data, no API key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Attribution rendered on the map. Keep the data source credited.
NEXT_PUBLIC_MAP_ATTRIBUTION=<a href="https://openfreemap.org" target="_blank" rel="noreferrer">OpenFreeMap</a> · <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">© OpenStreetMap contributors</a>

